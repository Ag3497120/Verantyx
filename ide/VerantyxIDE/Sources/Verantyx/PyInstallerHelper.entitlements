<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  PyInstaller onefile helpers (vera-memory, jgen_forge) extract a private
	  Python.framework / dylibs into $TMPDIR/_MEI* at launch. Those extracted
	  libraries are not signed with the same Team ID as the outer binary.
	  Hardened Runtime's library validation then rejects them with:
	    "mapping process and mapped file (non-platform) have different Team IDs"
	  which breaks MCP launch on every Mac that installs a notarized DMG.

	  disable-library-validation is the standard Apple-supported entitlement for
	  this class of self-extracting runtimes. allow-unsigned-executable-memory
	  is commonly required by frozen Python interpreters.
	-->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
