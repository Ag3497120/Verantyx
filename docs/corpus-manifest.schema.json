{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoloset.local/schema/garment.corpus-manifest.v1.json",
  "title": "Garment corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "version", "license", "lineage", "modalities",
    "record_format"
  ],
  "properties": {
    "schema": {"const": "garment.corpus-manifest.v1"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "homepage": {"type": "string", "format": "uri"},
    "citation": {"type": "string"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "rights"],
      "properties": {
        "spdx": {"type": ["string", "null"]},
        "url": {"type": "string", "format": "uri"},
        "attribution": {"type": "string"},
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commercial_use", "derivatives", "redistribution"],
          "properties": {
            "commercial_use": {"enum": ["allowed", "denied", "unknown"]},
            "derivatives": {"enum": ["allowed", "denied", "unknown"]},
            "redistribution": {"enum": ["allowed", "denied", "unknown"]}
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "generated": {"type": "boolean"},
          "generator": {"type": "string"},
          "generator_terms_url": {"type": "string", "format": "uri"},
          "human_validated": {"type": "boolean"}
        }
      }
    },
    "modalities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "garment_images", "calibrated_multiview", "segmentation_masks",
          "structure_graphs", "patterns_2d", "sewing_construction",
          "material_measurements", "drape_sequences", "meshes_3d"
        ]
      }
    },
    "record_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "schema_url"],
      "properties": {
        "units": {"enum": ["SI", "explicit_per_field"]},
        "schema_url": {"type": "string", "minLength": 1},
        "media_root": {"type": "string"},
        "shards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["uri", "sha256"],
            "properties": {
              "uri": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "records": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
